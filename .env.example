# ===== Room service (server) =====
# MySQL connection used by Drizzle (required in production)
DATABASE_URL=mysql://user:password@localhost:3306/classic_era

# Web origins allowed by CORS (comma-separated). Native apps have no Origin
# header and are always allowed. Production should use exact origins.
ALLOWED_ORIGINS=

# ===== Android / client service origins =====
# The Android build needs a reachable HTTPS origin that runs server/_core/index.ts.
# A dedicated regional relay pool may be supplied as a comma-separated list.
EXPO_PUBLIC_API_BASE_URL=https://your-netplay-server.example.com
EXPO_PUBLIC_NETPLAY_SERVICE_URL=https://your-netplay-server.example.com
EXPO_PUBLIC_NETPLAY_SERVICE_URLS=https://your-me-relay.example.com,https://your-eu-relay.example.com

# ===== LiveKit room voice (preferred) =====
# When all three are unset, the app falls back to the built-in WebRTC room voice.
LIVEKIT_URL=wss://your-livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ===== Built-in WebRTC fallback =====
# TURN is strongly recommended for mobile carrier / symmetric-NAT voice sessions.
EXPO_PUBLIC_TURN_URL=turn:your-turn.example.com:3478
EXPO_PUBLIC_TURN_USERNAME=
EXPO_PUBLIC_TURN_CREDENTIAL=
