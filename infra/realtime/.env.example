# Persistent realtime host
LIVEKIT_API_KEY=moudie_dev_key
LIVEKIT_API_SECRET=replace_with_a_long_random_secret
REDIS_PASSWORD=replace_with_a_long_random_secret
PUBLIC_IP=replace_with_the_server_public_ip
REALTIME_DOMAIN=realtime.example.com
TURN_DOMAIN=turn.example.com
TURN_CERT_FILE=/etc/livekit/certs/turn.crt
TURN_KEY_FILE=/etc/livekit/certs/turn.key
REDIS_ADDRESS=redis:6379
